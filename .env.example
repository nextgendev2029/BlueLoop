# ==============================================================================
# BlueLoop - Water Reuse Intelligence & Procurement Optimisation Platform
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to `.env` for local development. Never commit `.env` files
# containing real credentials, access keys, or sensitive secrets.
# ==============================================================================

# Application Environment & Identity
APP_ENV=development
APP_NAME=BlueLoop
APP_VERSION=0.1.0
DEBUG=true

# Service Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Target AWS Cloud Architecture (Placeholders for deployment configurations)
# Note: AWS resources are not created or active during foundation phase.
AWS_REGION=ap-south-1
AWS_DYNAMODB_TABLE=blueloop-core-dev
AWS_S3_BUCKET=blueloop-quality-docs-dev
COGNITO_USER_POOL_ID=ap-south-1_placeholderUserPoolId
COGNITO_CLIENT_ID=placeholderCognitoAppClientId
EVENTBRIDGE_BUS_NAME=blueloop-events-dev

# Synthetic Data & Safe Mode Indicator
USE_SYNTHETIC_DATA=true
DEMO_MODE=true
